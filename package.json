{
  "name": "nous-os-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "site:stage": "bash scripts/stage_static_site.sh",
    "site:dev": "node backend/server.cjs",
    "backend:dev": "node backend/server.cjs",
    "deploy:macos": "bash deploy/macos/install.sh",
    "worker:dev": "npm run site:stage && NOUS_BACKEND_ORIGIN_URL=${NOUS_BACKEND_ORIGIN_URL:-http://127.0.0.1:8787} wrangler dev",
    "deploy:cloudflare": "npm run site:stage && wrangler deploy",
    "test": "python3 -m unittest discover -s tests"
  },
  "devDependencies": {
    "wrangler": "^4.51.0"
  }
}
