#!/bin/sh
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base="$(git merge-base "$local_sha" origin/master 2>/dev/null || git rev-parse "$local_sha^")"
  else
    base="$remote_sha"
  fi
  PYTHONPATH=src python3 -m nous_os spec gate --range "${base}..${local_sha}"
done
